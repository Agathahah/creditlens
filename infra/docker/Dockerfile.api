# CreditLens API image — serves src.api.main:app with uvicorn on port 8000.
FROM python:3.12-slim AS runtime

# libgomp1 is required at runtime by XGBoost and LightGBM
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --no-cache-dir .

# Model artifact location; mount or bake artifacts into /app/models
ENV MODEL_PATH=/app/models/xgboost_credit.joblib

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
